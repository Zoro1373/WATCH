# MongoDB Connection String (e.g. from MongoDB Atlas Free Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=aquasentry

# Server Port (Render sets this automatically, default: 3000)
PORT=3000

# Authentication API Keys
API_KEY_FRONTEND=front_key_default
API_KEY_IOT=iot_key_default

# External APIs
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Python Binary (for Linux cloud environments, default: python3)
PYTHON_BIN=python3
