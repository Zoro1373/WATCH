# NitroStack MCP Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration
MCP_TRANSPORT_TYPE=http
MCP_PORT=3001
MCP_HOST=localhost

# WaterGuard Backend Connection (READ-ONLY)
# IMPORTANT: Put your actual API key only in your local uncommitted .env file.
WATERGUARD_BACKEND_URL=http://localhost:3000
WATERGUARD_API_KEY=<YOUR_LOCAL_WATERGUARD_API_KEY>

# SECURITY NOTE:
# MCP MUST NOT receive MONGODB_URI or MongoDB credentials.
# MCP MUST NOT connect directly to MongoDB.
